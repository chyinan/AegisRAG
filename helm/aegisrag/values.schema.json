{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "global",
    "secrets",
    "postgres",
    "redis",
    "minio",
    "migration",
    "api",
    "worker",
    "observability"
  ],
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "imageRegistry": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "postgres": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "redis": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "minio": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "migration": {
      "type": "object",
      "required": [
        "enabled",
        "expectedRevision"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "expectedRevision": {
          "const": "20261016_0021"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 30
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "ingestion": {
          "type": "object",
          "required": [
            "enabled",
            "replicas"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "replicas": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "embedding": {
          "type": "object",
          "required": [
            "enabled",
            "replicas"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "replicas": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "folderSync": {
          "type": "object",
          "required": [
            "enabled",
            "replicas"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "replicas": {
              "type": "integer",
              "minimum": 0
            },
            "apiUrl": {
              "type": "string"
            },
            "tokenSecret": {
              "type": "string"
            },
            "pollSeconds": {
              "type": "number",
              "minimum": 1,
              "maximum": 300
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "required": [
                  "apiUrl",
                  "tokenSecret"
                ],
                "properties": {
                  "apiUrl": {
                    "type": "string",
                    "pattern": "^https://[^/?#]+/?$"
                  },
                  "tokenSecret": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        },
        "durable": {
          "type": "object",
          "required": [
            "enabled",
            "replicas"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "replicas": {
              "type": "integer",
              "minimum": 0
            },
            "factory": {
              "type": "string"
            },
            "pollSeconds": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 3600
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "enabled": {
                    "const": true
                  }
                },
                "required": [
                  "enabled"
                ]
              },
              "then": {
                "required": [
                  "factory"
                ],
                "properties": {
                  "factory": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "observability": {
      "type": "object",
      "properties": {
        "prometheus": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "grafana": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "jaeger": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
