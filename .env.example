APP_ENV=local
LOG_LEVEL=INFO
ENABLE_DEV_AUTH_HEADERS=false
JWT_SECRET=<replace_with_jwt_secret_at_least_32_bytes>
JWT_ALGORITHM=HS256
JWT_ISSUER=<optional_jwt_issuer>
JWT_AUDIENCE=<optional_jwt_audience>
JWT_REQUIRE_LOCAL_SESSION=true
# For enterprise OIDC/JWKS (leave blank for local HS256; set
# JWT_REQUIRE_LOCAL_SESSION=false for an external identity provider):
JWT_JWKS_URL=
JWT_JWKS_ALGORITHMS=RS256
JWT_JWKS_CACHE_SECONDS=300
JWT_OIDC_TIMEOUT_SECONDS=2
SEED_TENANT_ID=default
POSTGRES_USER=rag_bootstrap
POSTGRES_PASSWORD=<replace_with_local_postgres_bootstrap_password>
POSTGRES_DB=rag_app
POSTGRES_MIGRATION_USER=rag_migrator
POSTGRES_MIGRATION_PASSWORD=<replace_with_local_postgres_migration_password>
POSTGRES_RUNTIME_USER=rag_runtime
POSTGRES_RUNTIME_PASSWORD=<replace_with_local_postgres_runtime_password>
DATABASE_URL=postgresql+asyncpg://rag_runtime:<replace_with_local_postgres_runtime_password>@postgres:5432/rag_app
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_MAX_REQUESTS=10000
RATE_LIMIT_WINDOW_SECONDS=60.0
RATE_LIMIT_BACKEND_TIMEOUT_SECONDS=1.0
HYBRID_DEGRADED_MODE=true
HYBRID_PARALLEL_ENABLED=true
QUEUE_JOB_TIMEOUT_SECONDS=900
QUEUE_RETRY_MAX=3
QUEUE_IDEMPOTENCY_TTL_SECONDS=86400
QUEUE_IDEMPOTENCY_LOCK_TTL_SECONDS=300
FOLDER_CONNECTOR_ROOT=/data/connectors
# Optional host path mounted read-only into the API connector root:
FOLDER_CONNECTOR_HOST_PATH=./connector-data
FOLDER_CURSOR_SECRET=replace-with-a-long-random-secret
HF_CACHE_HOST_PATH=./.cache/huggingface
GRAFANA_ADMIN_USER=admin
GRAPHANA_ADMIN_PASSWORD=<replace-with-a-random-password>
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin12345
MINIO_BUCKET=documents
MINIO_DOCUMENT_PREFIX=raw-documents
UPLOAD_MAX_BYTES=26214400

# === Alternative to MinIO: Use local file storage ===
LOCAL_FILE_STORAGE_ROOT=/ingested-documents
MINIO_ENABLED=false

# Optional: Mount host path for faster access (development only)
LOCAL_FILE_STORAGE_HOST_PATH=.
INGESTION_QUEUE_NAME=ingestion
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-embedding
EMBEDDING_DIM=8
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_PROVIDER_VERSION=
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_RETRY_BUDGET=2
EMBEDDING_QUEUE_NAME=embedding
# Keep fake as the default. For a real OpenAI-compatible embedding endpoint, set:
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_MODEL=<provider_embedding_model_id>
# EMBEDDING_BASE_URL=https://<compatible-endpoint>/v1
# EMBEDDING_API_KEY=<optional_provider_secret>
# For host Ollama from Docker Desktop, use:
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_API_KEY=
VECTOR_STORE_TYPE=pgvector
# Keep VECTOR_INDEX_DIM equal to EMBEDDING_DIM for the active embedding model.
VECTOR_INDEX_DIM=8
VECTOR_DISTANCE_METRIC=cosine
PGVECTOR_INDEX_TYPE=hnsw
PGVECTOR_HNSW_M=16
PGVECTOR_HNSW_EF_CONSTRUCTION=64
WORKER_QUEUE_NAME=ingestion
READINESS_TIMEOUT_SECONDS=2
LLM_PROVIDER=fake
LLM_MODEL=fake-llm
LLM_TIMEOUT_SECONDS=10
LLM_RETRY_BUDGET=2
LLM_FAKE_RESPONSE_TEXT=Fake LLM response.
# Keep fake as the default. For a real OpenAI-compatible endpoint, set:
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=<provider_model_id>
# LLM_BASE_URL=https://<compatible-endpoint>/v1
# LLM_API_KEY=<replace_with_secret>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=
LLM_TEMPERATURE=
LLM_PROVIDER_VERSION=
TOOL_DEFAULT_TIMEOUT_SECONDS=5
TOOL_DEFAULT_RATE_LIMIT_MAX_CALLS=30
TOOL_DEFAULT_RATE_LIMIT_WINDOW_SECONDS=60
FILE_READER_ALLOWLIST_ROOTS=docs
FILE_READER_MAX_FILE_BYTES=32768
FILE_READER_MAX_RETURN_BYTES=4096

# --- Reranker ---
# Options: fake, llm, openai_compatible, bge_local
RERANK_PROVIDER=fake
RERANK_TIMEOUT_SECONDS=30

# --- OCR ---
# Provider-neutral OCR backend. Options:
#   tesseract (default) — system tesseract binary
#   paddle               — pip install paddlepaddle paddleocr
#   surya                — pip install surya-ocr
OCR_PROVIDER=tesseract
OCR_TIMEOUT_SECONDS=300

AGENT_DEFAULT_MAX_STEPS=8
AGENT_DEFAULT_MAX_TOOL_CALLS=5
AGENT_DEFAULT_TIMEOUT_SECONDS=30
AGENT_REPEATED_ACTION_THRESHOLD=3
